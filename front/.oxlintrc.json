{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "jsx-a11y"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [".next/**", "out/**", "build/**", "node_modules/**", "next-env.d.ts"],
  "settings": {
    "react": {
      "version": "19"
    },
    "next": {
      "rootDir": "."
    }
  }
}
